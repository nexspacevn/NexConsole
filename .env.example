# NexConsole Environment Configuration Template
# Server Bind Address (default: 127.0.0.1 for local/reverse-proxy loopback safety, use 0.0.0.0 if direct LAN access is needed)
BIND_HOST=127.0.0.1
# Server Port
PORT=7681
# JWT Secret Key (replace with a 32+ character random string)
JWT_SECRET=your_super_secret_jwt_key_here
# Master Gateway Credentials (Layer 1)
LAYER1_USER=admin
LAYER1_PASS="your_secure_password_here"
# Master AES-256 Encryption Key for servers.db (Optional, fallback to JWT_SECRET if unset)
MASTER_KEY=your_dedicated_master_encryption_key_here
# Default Target SSH Server
SSH_HOST=127.0.0.1
SSH_PORT=22
# Terminal Idle Inactivity Timeout in seconds (default: 1800 = 30 minutes, 0 = disable)
TERMINAL_IDLE_TIMEOUT_SECS=1800
